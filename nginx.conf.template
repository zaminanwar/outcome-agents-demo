server {
    listen       ${PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # Hashed Next assets: cache for a year. ^~ so this beats the regex below.
    location ^~ /_next/static/ {
        expires 1y;
        try_files $uri =404;
    }

    # HTML is never cached: browsers must revalidate on every load so a new
    # deploy shows up immediately. (Without this, `/` carried no Cache-Control
    # header and browsers kept the old page by heuristic for hours.)
    location = / {
        expires -1;
        try_files /index.html =404;
    }

    location / {
        expires -1;
        try_files $uri $uri.html =404;
    }

    # Extensionless by export: nginx would otherwise serve it as octet-stream.
    location = /opengraph-image {
        default_type image/png;
        expires 1h;
        try_files $uri =404;
    }

    # Real 404s (no SPA fallback): unknown paths serve the Next 404 page.
    error_page 404 /404.html;
    location = /404.html {
        expires -1;
    }
    location = /index.html {
        expires -1;
    }

    # Fingerprint-free static assets briefly.
    location ~* \.(css|js|svg|png|ico|txt|xml)$ {
        expires 1h;
    }

    # Conservative headers for a page that loads nothing external.
    # script-src needs 'unsafe-inline': Next's static export hydrates from
    # inline RSC payload scripts and an inline theme script, so a strict
    # 'self'-only script-src would break the page outright.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self' 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'" always;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}

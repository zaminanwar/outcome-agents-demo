# Static-host headers (Cloudflare Pages format). The OG image is exported
# without a file extension, so set its MIME explicitly for social scrapers.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

# Immutable hashed build assets.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
